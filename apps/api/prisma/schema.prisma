generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  fullName         String
  remoteDeskId     String         @unique
  devicePassword   String?
  isOnline         Boolean        @default(false)
  socketId         String?
  lastSeenAt       DateTime?
  plan             Plan           @default(FREE)
  stripeCustomerId String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  devices          Device[]
  issuedCommands   DeviceCommand[] @relation("IssuedDeviceCommands")
  deviceAuditEvents DeviceAuditEvent[] @relation("DeviceAuditActors")
  launchChecks      LaunchCheck[] @relation("LaunchCheckCreators")
  releaseCandidates ReleaseCandidate[] @relation("ReleaseCandidateCreators")
  rolloutApprovals  RolloutApproval[] @relation("RolloutApprovalActors")
  migrationChecks   MigrationCheck[] @relation("MigrationCheckCreators")
  supportEscalationsCreated SupportEscalation[] @relation("SupportEscalationCreators")
  supportEscalationsAssigned SupportEscalation[] @relation("SupportEscalationAssignees")
  connectorInstallations ConnectorInstallation[] @relation("ConnectorInstallationUsers")
  connectorAuditEvents ConnectorAuditEvent[] @relation("ConnectorAuditActors")
  twoFactorSecret  String?
  twoFactorEnabled Boolean        @default(false)
  twoFactorBackupCodes String?
  subscriptions    Subscription[]
  hostSessions     Session[]      @relation("HostSessions")
  clientSessions   Session[]      @relation("ClientSessions")
  sessionAuditEvents SessionAuditEvent[] @relation("SessionAuditActors")
  accessControlEntries AccessControlEntry[]
  securityEvents   SecurityEvent[] @relation("SecurityEventActors")
  meshNetworks     MeshNetwork[]
}

model AccessControlEntry {
  id           String   @id @default(uuid())
  userId       String
  remoteDeskId String
  action       String   @default("block")
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, remoteDeskId])
  @@index([userId, action])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  name         String
  platform     String
  remoteDeskId String   @unique
  isOnline     Boolean  @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commands     DeviceCommand[]
  auditEvents  DeviceAuditEvent[]
  trustRecord     DeviceTrust?
  accessPolicy    DeviceAccessPolicy?
  locationHistory DeviceLocation[]
  securityEvents  SecurityEvent[] @relation("SecurityEventDevices")
  meshNode        MeshNode?
}

model DeviceTrust {
  id              String   @id @default(uuid())
  deviceId        String   @unique
  status          String   @default("untrusted")
  reason          String?
  trustedAt       DateTime?
  revokedAt       DateTime?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([updatedByUserId, updatedAt])
}

model DeviceAccessPolicy {
  id                       String   @id @default(uuid())
  deviceId                 String   @unique
  unattendedAccessEnabled  Boolean  @default(false)
  remoteInputEnabled       Boolean  @default(false)
  clipboardSyncEnabled     Boolean  @default(false)
  fileTransferEnabled      Boolean  @default(false)
  requiresSessionApproval  Boolean  @default(true)
  maxSessionMinutes        Int      @default(60)
  updatedByUserId          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  device                   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([unattendedAccessEnabled, updatedAt])
  @@index([remoteInputEnabled, updatedAt])
  @@index([updatedByUserId, updatedAt])
}

model DeviceCommand {
  id             String   @id @default(uuid())
  deviceId       String
  issuedByUserId String
  type           String
  status         String   @default("pending")
  payload        Json?
  result         Json?
  issuedAt       DateTime @default(now())
  expiresAt      DateTime
  deliveredAt    DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuedBy       User     @relation("IssuedDeviceCommands", fields: [issuedByUserId], references: [id], onDelete: Cascade)

  @@index([deviceId, status, expiresAt])
  @@index([issuedByUserId, createdAt])
}

model DeviceAuditEvent {
  id          String   @id @default(uuid())
  deviceId    String
  actorUserId String?
  type        String
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())

  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actor       User?    @relation("DeviceAuditActors", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([deviceId, createdAt])
  @@index([actorUserId, createdAt])
}

model LaunchCheck {
  id              String   @id @default(uuid())
  key             String   @unique
  area            String
  label           String
  status          String   @default("fail")
  required        Boolean  @default(true)
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy       User?    @relation("LaunchCheckCreators", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([area, status])
  @@index([createdByUserId, createdAt])
}

model ReleaseCandidate {
  id                 String   @id @default(uuid())
  version            String
  gitSha             String
  status             String   @default("draft")
  signedDesktopBuild Boolean  @default(false)
  migrationsReviewed Boolean  @default(false)
  smokeTestsPassed   Boolean  @default(false)
  notes              String?
  createdByUserId    String?
  promotedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy          User?    @relation("ReleaseCandidateCreators", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvals          RolloutApproval[]
  migrationChecks    MigrationCheck[]

  @@unique([version, gitSha])
  @@index([status, createdAt])
  @@index([createdByUserId, createdAt])
}

model RolloutApproval {
  id                 String   @id @default(uuid())
  releaseCandidateId String?
  requestedByUserId  String?
  area               String
  decision           String   @default("pending")
  reason             String?
  decidedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  releaseCandidate   ReleaseCandidate? @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  requestedBy         User?    @relation("RolloutApprovalActors", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([releaseCandidateId, decision])
  @@index([requestedByUserId, createdAt])
}

model MigrationCheck {
  id                 String   @id @default(uuid())
  releaseCandidateId String?
  name               String
  risk               String
  touchesAuth        Boolean  @default(false)
  touchesBilling     Boolean  @default(false)
  reviewed           Boolean  @default(false)
  destructive        Boolean  @default(false)
  backfillRows       Int      @default(0)
  status             String   @default("pending")
  notes              String?
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  releaseCandidate   ReleaseCandidate? @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  createdBy          User?    @relation("MigrationCheckCreators", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([releaseCandidateId, status])
  @@index([risk, reviewed])
  @@index([createdByUserId, createdAt])
}

model SupportEscalation {
  id               String   @id @default(uuid())
  title            String
  priority         String
  category         String
  target           String
  status           String   @default("open")
  description      String?
  createdByUserId  String?
  assignedToUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy        User?    @relation("SupportEscalationCreators", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo       User?    @relation("SupportEscalationAssignees", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([assignedToUserId, createdAt])
}

model ConnectorDefinition {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  category     String
  availability String   @default("available")
  description  String
  capabilities Json
  docsUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  installations ConnectorInstallation[]
  auditEvents   ConnectorAuditEvent[]

  @@index([category, availability])
}

model ConnectorInstallation {
  id           String   @id @default(uuid())
  connectorKey String
  userId       String
  status       String   @default("installed")
  installedAt  DateTime @default(now())
  uninstalledAt DateTime?
  config       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connector    ConnectorDefinition @relation(fields: [connectorKey], references: [key], onDelete: Cascade)
  user         User     @relation("ConnectorInstallationUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([connectorKey, userId])
  @@index([userId, status])
  @@index([connectorKey, status])
}

model ConnectorAuditEvent {
  id           String   @id @default(uuid())
  connectorKey String
  userId       String?
  type         String
  message      String
  metadata     Json?
  createdAt    DateTime @default(now())

  connector    ConnectorDefinition @relation(fields: [connectorKey], references: [key], onDelete: Cascade)
  user         User?    @relation("ConnectorAuditActors", fields: [userId], references: [id], onDelete: SetNull)

  @@index([connectorKey, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Session {
  id        String        @id @default(uuid())
  hostId    String
  clientId  String
  status    SessionStatus @default(PENDING)
  startedAt DateTime?
  endedAt   DateTime?
  duration  Int?
  createdAt DateTime      @default(now())
  host      User          @relation("HostSessions", fields: [hostId], references: [id])
  client    User          @relation("ClientSessions", fields: [clientId], references: [id])
  auditEvents SessionAuditEvent[]
}

model SessionAuditEvent {
  id          String   @id @default(uuid())
  sessionId   String?
  actorUserId String?
  type        String
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())

  session     Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  actor       User?    @relation("SessionAuditActors", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([type, createdAt])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceLocation {
  id        String   @id @default(uuid())
  deviceId  String
  latitude  Float
  longitude Float
  accuracy  Float?
  altitude  Float?
  speed     Float?
  heading   Float?
  ip        String?
  city      String?
  country   String?
  isp       String?
  timestamp DateTime @default(now())

  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  type      String
  userId    String
  ip        String
  deviceId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation("SecurityEventActors", fields: [userId], references: [id], onDelete: Cascade)
  device    Device?  @relation("SecurityEventDevices", fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([ip, createdAt])
}

enum Plan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SessionStatus {
  PENDING
  ACTIVE
  ENDED
  REJECTED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}


// ============================================================
// Built-in VPN & Mesh Networking models
// ============================================================

model MeshNetwork {
  id              String          @id @default(uuid())
  userId          String
  name            String          @default("My Network")
  ipv4Cidr        String          @default("100.64.0.0/10")
  ipv6Cidr        String          @default("fd7a:115c:a1e0::/48")
  magicDnsDomain  String          @default("remotedesk.net")
  magicDnsEnabled Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes           MeshNode[]
  acls            MeshAcl[]
  routes          MeshRoute[]
  dnsRecords      MeshDnsRecord[]
  speedTests      MeshSpeedTest[]
  multiHopRoutes  MeshMultiHopRoute[]
  hotspotSessions MeshHotspotSession[]
  invites         MeshNetworkInvite[]
  peerEvents      MeshPeerEvent[]
  @@index([userId])
}

model MeshNode {
  id               String        @id @default(uuid())
  networkId        String
  deviceId         String        @unique
  name             String
  publicKey        String        @unique
  virtualIpV4      String        @unique
  virtualIpV6      String        @unique
  magicDnsName     String        @unique
  endpoints        String[]      @default([])
  relayRegion      String?
  os               String        @default("unknown")
  clientVersion    String?
  isExitNode       Boolean       @default(false)
  exitNodeEnabled  Boolean       @default(false)
  advertisedRoutes String[]      @default([])
  tags             String[]      @default([])
  online           Boolean       @default(false)
  lastHandshakeAt  DateTime?
  lastSeenAt       DateTime      @default(now())
  alwaysOn         Boolean       @default(true)
  keepaliveSeconds Int           @default(25)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  network          MeshNetwork   @relation(fields: [networkId], references: [id], onDelete: Cascade)
  device           Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  approvedRoutes   MeshRoute[]   @relation("RouteAdvertiser")
  splitTunnelRules MeshSplitTunnelRule[]
  @@index([networkId, online])
  @@index([networkId, isExitNode])
}

model MeshRoute {
  id            String      @id @default(uuid())
  networkId     String
  advertiserId  String
  cidr          String
  kind          String      @default("subnet")
  approved      Boolean     @default(false)
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  network       MeshNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  advertiser    MeshNode    @relation("RouteAdvertiser", fields: [advertiserId], references: [id], onDelete: Cascade)
  @@unique([advertiserId, cidr])
  @@index([networkId, approved])
}

model MeshAcl {
  id          String      @id @default(uuid())
  networkId   String
  action      String      @default("accept")
  src         String
  dst         String
  ports       String      @default("*")
  schedule    String?
  priority    Int         @default(100)
  enabled     Boolean     @default(true)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  network     MeshNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  @@index([networkId, enabled, priority])
}

model MeshDnsRecord {
  id        String      @id @default(uuid())
  networkId String
  name      String
  type      String      @default("A")
  value     String
  auto      Boolean     @default(true)
  createdAt DateTime    @default(now())
  network   MeshNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  @@unique([networkId, name, type])
  @@index([networkId])
}

model MeshSpeedTest {
  id            String      @id @default(uuid())
  networkId     String
  fromNodeId    String
  toNodeId      String
  downMbps      Float
  upMbps        Float
  latencyMs     Float
  jitterMs      Float       @default(0)
  packetLoss    Float       @default(0)
  via           String      @default("direct")
  createdAt     DateTime    @default(now())
  network       MeshNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  @@index([networkId, createdAt])
}

model MeshPortForward {
  id            String   @id @default(uuid())
  networkId     String
  targetNodeId  String
  targetPort    Int
  protocol      String   @default("tcp")
  ingressHost   String   @unique
  ingressPort   Int
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([networkId, enabled])
}

model MeshMultiHopRoute {
  id          String      @id @default(uuid())
  networkId   String
  sourceNodeId String
  targetNodeId String
  hopNodeIds  String[]
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  network     MeshNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  @@unique([sourceNodeId, targetNodeId])
  @@index([networkId, enabled])
}

model MeshHotspotSession {
  id          String      @id @default(uuid())
  networkId   String
  providerNodeId String
  enabled     Boolean     @default(false)
  ssid        String?
  startedAt   DateTime?
  stoppedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  network     MeshNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  @@index([networkId, enabled])
}

model MeshSplitTunnelRule {
  id          String      @id @default(uuid())
  nodeId      String
  kind        String      @default("cidr")
  value       String
  action      String      @default("include")
  appId       String?
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  node        MeshNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  @@index([nodeId, enabled])
}

model MeshNetworkInvite {
  id          String      @id @default(uuid())
  networkId   String
  tokenHash   String      @unique
  role        String      @default("member")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())
  network     MeshNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  @@index([networkId, expiresAt])
}

model MeshPeerEvent {
  id          String      @id @default(uuid())
  networkId   String
  nodeId      String
  type        String
  metadata    Json?
  createdAt   DateTime    @default(now())
  network     MeshNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  @@index([networkId, createdAt])
  @@index([nodeId, createdAt])
}

// Relations for the additional mesh control-plane models.
// Prisma requires the opposite collections on the referenced models.

// MeshNetwork: multihop/hotspot/invite/event relations are declared here via
// the collections below using explicit model fields added to MeshNetwork.

// NOTE: the collection fields are part of MeshNetwork above in the final schema.

